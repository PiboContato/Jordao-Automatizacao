# ============================================================
# ARQUIVO DE EXEMPLO — NÃO COLOCAR CREDENCIAIS REAIS AQUI
# Copie este arquivo para .env e preencha com seus dados reais
# O arquivo .env NUNCA deve ser commitado (ver .gitignore)
# ============================================================

# --- Credenciais do Sistema Astral ---
JORDAO_URL=https://phcfocosistema.com.br/astral36/
JORDAO_USUARIO=seu_usuario_aqui
JORDAO_SENHA=sua_senha_aqui

# --- Credenciais do Painel Web (Dashboard) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=admin

# --- Pasta de destino dos relatórios ---
PASTA_DESTINO=C:\Astral Automatizacao\relatorios

# --- Configurações de E-mail (Outlook/Hotmail via SMTP) ---
EMAIL_REMETENTE=seu_email@outlook.com
EMAIL_SENHA=sua_senha_email_aqui
EMAIL_DESTINATARIO=destinatario@email.com
# Múltiplos destinatários separados por vírgula:
# EMAIL_DESTINATARIO=email1@exemplo.com,email2@exemplo.com
SMTP_SERVIDOR=smtp-mail.outlook.com
SMTP_PORTA=587

# --- Comportamento do agente ---
# true = roda sem abrir janela do navegador (produção)
# false = mostra o navegador (debugging)
HEADLESS=false

# --- Timeouts (em milissegundos) ---
TIMEOUT_NAVEGACAO=30000
TIMEOUT_DOWNLOAD=60000

# --- Retry ---
TENTATIVAS_MAX=3
ESPERA_ENTRE_TENTATIVAS=10
