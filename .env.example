# ============================================================
# ARQUIVO DE EXEMPLO — NÃO COLOCAR CREDENCIAIS REAIS AQUI
# Copie este arquivo para .env e preencha com seus dados reais
# O arquivo .env NUNCA deve ser commitado (ver .gitignore)
# ============================================================

# --- Credenciais do Sistema Jordão ---
JORDAO_URL=https://admin.jordaogestaodeimoveis.com.br/login
JORDAO_USUARIO=seu_usuario_aqui
JORDAO_SENHA=sua_senha_aqui

# --- URL base do sistema (usada para navegar aos relatórios) ---
# Normalmente é o domínio sem /login. Só alterar se o domínio mudar.
JORDAO_BASE_URL=https://admin.jordaogestaodeimoveis.com.br

# --- Credenciais do Painel Web (Dashboard) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=admin

# --- Chave secreta do Flask (troque por algo aleatório) ---
SECRET_KEY=gerar_uma_chave_aleatoria_como_314159265358979323846264

# --- Pasta de destino dos relatórios (opcional) ---
# Se vazio, usa "Relatorios/" na raiz do projeto
PASTA_DESTINO=

# --- Supabase (Banco de Dados) ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=chave_de_servico_do_supabase

# --- Configurações de E-mail (Outlook/Hotmail via SMTP) ---
EMAIL_REMETENTE=seu_email@outlook.com
EMAIL_SENHA=sua_senha_email_aqui
EMAIL_DESTINATARIO=destinatario@email.com
# Múltiplos destinatários separados por vírgula:
# EMAIL_DESTINATARIO=email1@exemplo.com,email2@exemplo.com
SMTP_SERVIDOR=smtp-mail.outlook.com
SMTP_PORTA=587

# --- Comportamento do agente ---
# true = roda sem abrir janela do navegador (produção)
# false = mostra o navegador (debugging)
HEADLESS=true

# --- Timeouts (em milissegundos) ---
# Aumentados para ambiente cloud (rede pode ser mais lenta)
TIMEOUT_NAVEGACAO=60000
TIMEOUT_DOWNLOAD=120000

# --- Retry ---
TENTATIVAS_MAX=3
ESPERA_ENTRE_TENTATIVAS=10
